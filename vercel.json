{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/flights/:path*",
      "destination": "/api/gateway?path=flights/:path*"
    },
    {
      "source": "/api/celestrak/:path*",
      "destination": "/api/gateway?path=celestrak/:path*"
    },
    {
      "source": "/api/launches/:path*",
      "destination": "/api/gateway?path=launches/:path*"
    },
    {
      "source": "/api/military/:path*",
      "destination": "/api/gateway?path=military/:path*"
    },
    {
      "source": "/api/weather/:path*",
      "destination": "/api/gateway?path=weather/:path*"
    },
    {
      "source": "/api/cyclones/:path*",
      "destination": "/api/gateway?path=cyclones/:path*"
    },
    {
      "source": "/api/fire-perimeters/:path*",
      "destination": "/api/gateway?path=fire-perimeters/:path*"
    },
    {
      "source": "/api/radio/:path*",
      "destination": "/api/gateway?path=radio/:path*"
    },
    {
      "source": "/api/regional-brief/:path*",
      "destination": "/api/gateway?path=regional-brief/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
